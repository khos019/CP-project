{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "algoyol",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "routes": [
    { "pattern": "algoyol.uz", "custom_domain": true },
    { "pattern": "www.algoyol.uz", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}
