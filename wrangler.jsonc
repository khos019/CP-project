{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "algoyol",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "routes": [
    { "pattern": "algoyol.uz", "custom_domain": true },
    { "pattern": "www.algoyol.uz", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  // Per-account budgets read by app/api/_lib/guard.ts (keep FALLBACK there in
  // step). Counted per Cloudflare location, so a learner moving between
  // locations gets a little more, never less.
  "ratelimits": [
    { "name": "JUDGE_LIMITER", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } },
    { "name": "DUEL_LIMITER", "namespace_id": "1002", "simple": { "limit": 150, "period": 60 } }
  ]
}
